{
  "name": "@workspace/cloudpainter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:image-dimensions": "node --experimental-strip-types --test src/lib/imageDimensions.test.ts",
    "test:outline": "node --experimental-strip-types --test --test-timeout=10000 src/lib/outlinePrivacy.test.ts",
    "test:outline-model-browser": "node --test --test-timeout=230000 tests/outline-subject-regression.browser.mjs",
    "test:outline-ui": "vitest run --config vitest.outline.config.ts",
    "test:stroke-renderer": "node --experimental-strip-types --test --test-timeout=10000 src/lib/strokeRenderer.test.ts",
    "test:layer-clipboard": "node --experimental-strip-types --test --test-timeout=10000 src/lib/layerClipboard.test.ts",
    "test:clipboard-browser": "playwright test --config playwright.clipboard.config.ts",
    "test:drawing-tools": "node --experimental-strip-types --test --test-timeout=10000 src/lib/drawingTools.test.ts",
    "test:instruments-browser": "playwright test --config playwright.instruments.config.ts",
    "test:brushes-browser": "playwright test --config playwright.brush.config.ts",
    "test:drawing-colors": "node --experimental-strip-types --test src/lib/drawingColors.test.ts",
    "test:palettes": "node --experimental-strip-types --test src/lib/palettePersistence.test.ts",
    "test:drawing-colors-browser": "node --test tests/drawing-colors.browser.test.mjs",
    "test:keyboard-shortcuts": "node --test tests/keyboard-shortcuts.browser.test.mjs",
    "test:photo-export": "node --test tests/photo-export.browser.test.mjs",
    "test:photo-card": "playwright test --config playwright.config.ts",
    "test:anonymous-photo-and-images": "playwright test --config playwright.config.ts --grep-invert 'signed-in generation'",
    "test:logo-browser": "node --test tests/logo-preview.browser.test.mjs",
    "test:poe-images": "playwright test --config playwright.config.ts ImageGenerator.test.tsx",
    "test:tooltips": "playwright test --config playwright.tooltip.config.ts",
    "test:logo-ui": "vitest run --config vitest.logo.config.ts",
    "test:upscale-ui": "vitest run --config vitest.logo.config.ts src/components/PoeUpscaleExport.test.tsx"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/api-zod": "workspace:*",
