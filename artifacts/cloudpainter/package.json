    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "catalog:",
    "input-otp": "^1.4.2",
    "jsdom": "^30.1.2",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.64.0",
    "react": "~19.1.4",
    "react-day-picker": "^9.11.1",
    "react-dom": "~19.1.4",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "catalog:",
    "vitest": "^5.0.3",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "@clerk/react": "^6.17.7",
    "@clerk/themes": "^2.4.57",
    "@huggingface/transformers": "3.8.1",
    "@workspace/outline-core": "workspace:*",
    "perfect-freehand": "^1.2.3"
  }
}
