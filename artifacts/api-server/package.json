{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:image-access": "tsx scripts/setup-image-access.ts",
    "test:image-access": "tsx --test tests/image-access.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:palettes": "tsx --test src/routes/palettes.test.ts",
    "test:logo-api": "node --import tsx --test tests/logo-images.test.ts",
    "verify:logo-live": "node --import tsx tests/verify-logo-live.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.77",
    "@clerk/shared": "^4.39.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "openai": "^7.31.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
