{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "node scripts/workspace-typecheck.mjs --libs",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:cloudpainter": "node scripts/workspace-typecheck.mjs artifacts/cloudpainter",
    "typecheck:api-server": "node scripts/workspace-typecheck.mjs artifacts/api-server",
    "test:workspace-typecheck": "node --test --test-timeout=240000 scripts/tests/workspace-typecheck.test.mjs",
    "validate:task-plans": "node scripts/validate-task-plans.mjs",
    "test:regression-guard": "node --test scripts/tests/check-regression-guard.test.mjs",
    "test:readme-sync": "node --test scripts/tests/daily-readme-sync.test.mjs",
    "test:failure-gate": "node --test --test-timeout=45000 scripts/tests/failure-gate.test.mjs",
    "test-fast": "node scripts/validation-tier.mjs test-fast",
    "test-standard": "node scripts/validation-tier.mjs test-standard",
    "test-standard-plus": "node scripts/validation-tier.mjs test-standard-plus",
    "test-heavy": "node scripts/validation-tier.mjs test-heavy",
    "gate:inspect": "node scripts/check-failure-gate.mjs",
    "workspace-skill:refresh": "python3 -B scripts/workspace_skill_sync/cli.py refresh",
    "workspace-skill:status": "python3 -B scripts/workspace_skill_sync/cli.py status",
    "gate:baseline-warnings": "node scripts/maintain-failure-baseline.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
